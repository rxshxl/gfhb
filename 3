#include <iostream>
using namespace std;

int main() {
    int ball;
    cin >> ball;

    if (ball >= 90)      cout << "A" << endl;
    else if (ball >= 80) cout << "B" << endl;
    else if (ball >= 70) cout << "C" << endl;
    else if (ball >= 60) cout << "D" << endl;
    else if (ball<=60)   cout << "F" << endl;

    return 0;
}
