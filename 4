#include <iostream>
using namespace std;

int main() {
    int total_elements;

    if (cin >> total_elements) {
        int even_count = 0;
        int odd_count = 0;

        for (int k = 0; k < total_elements; ++k) {
            int current_number;

            if (cin >> current_number) {
                if (current_number % 2 == 0) {
                    even_count++;
                } else {
                    odd_count++;
                }
            } else {
                cout << "Ошибка.";
                return 1;
            }
        }

        cout << even_count << " " << odd_count << endl;
    } else {
        cout << "Ошибка." << endl;
        return 1;
    }

    return 0;
}

